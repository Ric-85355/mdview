#!/usr/bin/env python3
# mdview — created 2026-08-25, version 0.3.0.
# Purpose: browse one HTTP repository and read Markdown in a two-pane curses UI.
# Algorithm: validate repository metadata or parse local source lines, then use
# the existing mapped Reader for rendering, navigation, resize, and search.

"""A small, read-only Markdown viewer for UTF-8 Linux terminals."""

from __future__ import annotations

import argparse
import curses
import json
import locale
import logging
import re
import sys
import textwrap
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import urljoin, urlsplit
from urllib.request import Request, urlopen


VERSION = "0.3.0"
REPOSITORY_URL = "http://ricaro.top/mdrepo/"
HTTP_TIMEOUT_SECONDS = 10
MIN_TERMINAL_HEIGHT = 8
MIN_TERMINAL_WIDTH = 40
MIN_PANEL_WIDTH = 12
TOC_RATIO = 0.30
SEARCH_HIGHLIGHT_ATTRIBUTE = curses.A_BOLD | curses.A_UNDERLINE
LOG = logging.getLogger("mdview")

HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.+?)[ \t]*#*[ \t]*$")
UNORDERED_LIST_RE = re.compile(r"^( {0,8})(-)\s+(?!\[[ xX]\](?:\s|$))(.*)$")
ORDERED_LIST_RE = re.compile(r"^( {0,8})(\d+\.)\s+(.*)$")
INDENTED_CODE_RE = re.compile(r"^(?: {4}|\t)")
LINK_RE = re.compile(r"\[([^]\n]+)\]\(([^)\n]+)\)")
TABLE_SEPARATOR_CELL_RE = re.compile(r"-{3,}")
UNORDERED_LIST_MARKERS = ("◆", "▸", "▪")


@dataclass(frozen=True)
class Heading:
    """A table-of-contents entry tied to a source line."""

    level: int
    title: str
    source_line: int


@dataclass(frozen=True)
class VisualLine:
    """One displayed row and the source line from which it originated."""

    text: str
    source_line: int
    style: str = "normal"
    source_offsets: tuple[int | None, ...] = ()


@dataclass(frozen=True)
class SearchMatch:
    """One case-insensitive match within a source line."""

    source_line: int
    source_start: int
    source_end: int


@dataclass(frozen=True)
class RepositoryDocument:
    """A remote Markdown document described by a repository index."""

    name: str
    path: str


@dataclass(frozen=True)
class RepositoryDirectory:
    """A repository directory with direct documents and nested directories."""

    name: str
    path: tuple[str, ...]
    directories: tuple[RepositoryDirectory, ...]
    documents: tuple[RepositoryDocument, ...]


@dataclass(frozen=True)
class Repository:
    """Validated read-only repository metadata used by Repository View."""

    name: str
    directories: tuple[RepositoryDirectory, ...]


class RepositoryError(ValueError):
    """Report an invalid or unavailable remote repository without a traceback."""


def _required_string(item: dict[str, Any], field: str, context: str) -> str:
    """Return one required non-empty string from repository metadata."""
    value = item.get(field)
    if not isinstance(value, str) or not value.strip():
        raise RepositoryError(f"{context} has no valid {field}")
    return value.strip()


def _parse_repository_items(
    items: Any, parent_path: tuple[str, ...]
) -> tuple[tuple[RepositoryDirectory, ...], tuple[RepositoryDocument, ...]]:
    """Validate repository items and split directories from direct documents."""
    if not isinstance(items, list):
        raise RepositoryError("repository items must be a list")
    directories: list[RepositoryDirectory] = []
    documents: list[RepositoryDocument] = []
    for position, raw_item in enumerate(items):
        context = f"repository item {position}"
        if not isinstance(raw_item, dict):
            raise RepositoryError(f"{context} must be an object")
        item_type = raw_item.get("type")
        name = _required_string(raw_item, "name", context)
        if item_type == "directory":
            child_path = (*parent_path, name)
            child_directories, child_documents = _parse_repository_items(
                raw_item.get("items"), child_path
            )
            directories.append(
                RepositoryDirectory(
                    name,
                    child_path,
                    child_directories,
                    child_documents,
                )
            )
        elif item_type == "document":
            path = _required_string(raw_item, "path", context)
            parts = urlsplit(path)
            if (
                parts.scheme
                or parts.netloc
                or path.startswith("/")
                or any(part in {"", ".", ".."} for part in parts.path.split("/"))
            ):
                raise RepositoryError(f"{context} has an unsafe path")
            documents.append(RepositoryDocument(name, path))
        else:
            raise RepositoryError(f"{context} has unsupported type")
    return tuple(directories), tuple(documents)


def parse_repository_json(source: str) -> Repository:
    """Parse and validate the supported version of repository.json."""
    try:
        raw = json.loads(source)
    except json.JSONDecodeError as error:
        raise RepositoryError(f"invalid repository JSON: {error.msg}") from error
    if not isinstance(raw, dict):
        raise RepositoryError("repository index must be an object")
    if raw.get("format") != 1:
        raise RepositoryError("unsupported repository format")
    name = _required_string(raw, "name", "repository")
    directories, _root_documents = _parse_repository_items(raw.get("items"), ())
    return Repository(name, directories)


def repository_directories(
    repository: Repository,
) -> list[tuple[RepositoryDirectory, int]]:
    """Flatten the directory tree for display while retaining nesting depth."""
    result: list[tuple[RepositoryDirectory, int]] = []

    def visit(directories: tuple[RepositoryDirectory, ...], depth: int) -> None:
        for directory in directories:
            result.append((directory, depth))
            visit(directory.directories, depth + 1)

    visit(repository.directories, 0)
    return result


def document_url(repository_url: str, document_path: str) -> str:
    """Build an absolute document URL relative to the repository root."""
    root = repository_url.rstrip("/") + "/"
    parts = urlsplit(document_path)
    if (
        parts.scheme
        or parts.netloc
        or document_path.startswith("/")
        or any(part in {"", ".", ".."} for part in parts.path.split("/"))
    ):
        raise RepositoryError("document has an unsafe path")
    return urljoin(root, document_path)


def fetch_utf8(url: str) -> str:
    """Download one UTF-8 repository resource using the standard library."""
    request = Request(url, headers={"User-Agent": f"mdview/{VERSION}"})
    try:
        with urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            payload = response.read()
    except HTTPError as error:
        raise RepositoryError(f"HTTP {error.code} for {url}") from error
    except URLError as error:
        raise RepositoryError(f"could not connect to {url}: {error.reason}") from error
    except OSError as error:
        raise RepositoryError(f"could not read {url}: {error}") from error
    try:
        return payload.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RepositoryError(f"response is not valid UTF-8: {url}") from error


def load_repository(repository_url: str) -> Repository:
    """Download and parse repository.json for one repository root URL."""
    return parse_repository_json(fetch_utf8(urljoin(repository_url, "repository.json")))


def parse_headings(lines: list[str]) -> list[Heading]:
    """Return level 1–3 ATX headings, excluding fenced code blocks."""
    headings: list[Heading] = []
    in_fence = False
    for source_line, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = HEADING_RE.match(line)
        if match and len(match.group(1)) <= 3:
            headings.append(
                Heading(len(match.group(1)), match.group(2).strip(), source_line)
            )
    return headings


def _wrapped(text: str, width: int, subsequent_indent: str = "") -> list[str]:
    """Wrap text without breaking words unless a word alone exceeds the width."""
    wrapper = textwrap.TextWrapper(
        width=max(1, width),
        subsequent_indent=subsequent_indent,
        replace_whitespace=False,
        drop_whitespace=True,
        break_long_words=True,
        break_on_hyphens=False,
    )
    return wrapper.wrap(text) or [""]


def _expand_tabs_with_offsets(
    text: str, source_offsets: list[int | None], tab_size: int = 8
) -> tuple[str, list[int | None]]:
    """Expand tabs while retaining the source offset of every displayed space."""
    expanded: list[str] = []
    expanded_offsets: list[int | None] = []
    column = 0
    for character, source_offset in zip(text, source_offsets):
        if character == "\t":
            spaces = tab_size - column % tab_size
            expanded.extend(" " * spaces)
            expanded_offsets.extend([source_offset] * spaces)
            column += spaces
        else:
            expanded.append(character)
            expanded_offsets.append(source_offset)
            column += 1
    return "".join(expanded), expanded_offsets


def _mapped_wrapped(
    text: str,
    source_offsets: list[int | None],
    width: int,
    subsequent_indent: str = "",
) -> list[tuple[str, tuple[int | None, ...]]]:
    """Wrap text and attach source offsets to each resulting display character."""
    expanded, expanded_offsets = _expand_tabs_with_offsets(text, source_offsets)
    parts = _wrapped(expanded, width, subsequent_indent)
    result: list[tuple[str, tuple[int | None, ...]]] = []
    search_from = 0
    for index, part in enumerate(parts):
        indent_length = (
            len(subsequent_indent)
            if index > 0 and part.startswith(subsequent_indent)
            else 0
        )
        content = part[indent_length:]
        content_start = expanded.find(content, search_from) if content else search_from
        if content_start < 0:
            content_start = search_from
        content_end = content_start + len(content)
        offsets = (None,) * indent_length + tuple(
            expanded_offsets[content_start:content_end]
        )
        result.append((part, offsets))
        search_from = content_end
    return result


def render_minimal_markdown(
    text: str, source_start: int = 0, uppercase: bool = False
) -> tuple[str, list[int | None]]:
    """Transform links and optional heading case while preserving source offsets."""
    rendered: list[str] = []
    offsets: list[int | None] = []

    def append_text(fragment: str, fragment_offsets: list[int | None]) -> None:
        for character, source_offset in zip(fragment, fragment_offsets):
            displayed = character.upper() if uppercase else character
            rendered.extend(displayed)
            offsets.extend([source_offset] * len(displayed))

    position = 0
    for match in LINK_RE.finditer(text):
        if text.count("`", 0, match.start()) % 2:
            continue
        append_text(
            text[position : match.start()],
            list(range(source_start + position, source_start + match.start())),
        )
        append_text(
            match.group(1),
            list(
                range(
                    source_start + match.start(1),
                    source_start + match.end(1),
                )
            ),
        )
        append_text(" ", [None])
        append_text("(", [source_start + match.start(2) - 1])
        append_text(
            match.group(2),
            list(
                range(
                    source_start + match.start(2),
                    source_start + match.end(2),
                )
            ),
        )
        append_text(")", [source_start + match.end() - 1])
        position = match.end()
    append_text(
        text[position:],
        list(range(source_start + position, source_start + len(text))),
    )
    return "".join(rendered), offsets


def document_attribute(style: str) -> int:
    """Return the minimal curses attribute used for a document line style."""
    return {
        "heading1": curses.A_BOLD,
        "heading2": curses.A_BOLD | curses.A_UNDERLINE,
        "heading3": curses.A_UNDERLINE,
        "heading": curses.A_BOLD | curses.A_UNDERLINE,
        "code": curses.A_DIM,
    }.get(style, curses.A_NORMAL)


def _table_cells(line: str) -> list[tuple[str, tuple[int, ...]]] | None:
    """Return trimmed table cells and their source offsets."""
    if "|" not in line:
        return None
    boundaries = [-1, *(match.start() for match in re.finditer(r"\|", line)), len(line)]
    cells: list[tuple[str, tuple[int, ...]]] = []
    for left, right in zip(boundaries, boundaries[1:]):
        start = left + 1
        end = right
        while start < end and line[start].isspace():
            start += 1
        while end > start and line[end - 1].isspace():
            end -= 1
        cells.append((line[start:end], tuple(range(start, end))))

    if line.lstrip().startswith("|"):
        cells.pop(0)
    if line.rstrip().endswith("|"):
        cells.pop()
    return cells if len(cells) >= 2 else None


def _table_at(
    lines: list[str], start: int, width: int
) -> tuple[list[VisualLine], int] | None:
    """Render a simple table beginning at start, or report that none exists."""
    if start + 1 >= len(lines):
        return None
    header = _table_cells(lines[start])
    separator = _table_cells(lines[start + 1])
    if (
        header is None
        or separator is None
        or len(header) != len(separator)
        or not all(TABLE_SEPARATOR_CELL_RE.fullmatch(cell) for cell, _ in separator)
    ):
        return None

    rows = [(start, header)]
    next_line = start + 2
    while next_line < len(lines):
        cells = _table_cells(lines[next_line])
        if cells is None or len(cells) != len(header):
            break
        rows.append((next_line, cells))
        next_line += 1

    column_widths = [
        max(display_width(cells[column][0]) for _, cells in rows)
        for column in range(len(header))
    ]
    visual_lines: list[VisualLine] = []
    for source_line, cells in rows:
        rendered: list[str] = []
        offsets: list[int | None] = []
        for column, (cell, cell_offsets) in enumerate(cells):
            rendered.extend(cell)
            offsets.extend(cell_offsets)
            if column < len(cells) - 1:
                padding = column_widths[column] - display_width(cell)
                rendered.extend(" " * padding + " | ")
                offsets.extend([None] * (padding + 3))
        text = clip_to_display_width("".join(rendered), width)
        visual_lines.append(
            VisualLine(text, source_line, "table", tuple(offsets[: len(text)]))
        )
    return visual_lines, next_line


def build_visual_lines(lines: list[str], width: int) -> list[VisualLine]:
    """Build display rows while preserving their source-line mapping."""
    width = max(1, width)
    result: list[VisualLine] = []
    in_fence = False

    source_line = 0
    while source_line < len(lines):
        line = lines[source_line]
        stripped = line.lstrip()
        if stripped.startswith("```"):
            text = line[:width]
            result.append(
                VisualLine(text, source_line, "code", tuple(range(len(text))))
            )
            in_fence = not in_fence
            source_line += 1
            continue
        list_line = UNORDERED_LIST_RE.match(line) or ORDERED_LIST_RE.match(line)
        if in_fence or (INDENTED_CODE_RE.match(line) and list_line is None):
            text = line[:width]
            result.append(
                VisualLine(text, source_line, "code", tuple(range(len(text))))
            )
            source_line += 1
            continue

        table = _table_at(lines, source_line, width)
        if table is not None:
            table_lines, source_line = table
            result.extend(table_lines)
            continue

        heading = HEADING_RE.match(line)
        if heading:
            heading_level = len(heading.group(1))
            if heading_level <= 3:
                style = f"heading{heading_level}"
                rendered, offsets = render_minimal_markdown(
                    heading.group(2),
                    heading.start(2),
                    uppercase=heading_level == 1,
                )
                parts = _mapped_wrapped(rendered, offsets, width)
            else:
                style = "heading"
                parts = _mapped_wrapped(line, list(range(len(line))), width)
        else:
            unordered = UNORDERED_LIST_RE.match(line)
            ordered = ORDERED_LIST_RE.match(line)
            list_match = unordered or ordered
            if list_match:
                marker = list_match.group(2)
                if unordered:
                    level = min(len(list_match.group(1)) // 2, 2)
                    marker = UNORDERED_LIST_MARKERS[level]
                prefix = f"{list_match.group(1)}{marker} "
                rendered, content_offsets = render_minimal_markdown(
                    list_match.group(3), list_match.start(3)
                )
                transformed = prefix + rendered
                marker_end = list_match.start(2) + len(marker)
                offsets: list[int | None] = list(range(marker_end))
                offsets.append(marker_end)
                offsets.extend(content_offsets)
                parts = _mapped_wrapped(
                    transformed, offsets, width, " " * len(prefix)
                )
                style = "list"
            else:
                rendered, offsets = render_minimal_markdown(line)
                parts = _mapped_wrapped(rendered, offsets, width)
                style = "normal"

        result.extend(
            VisualLine(part, source_line, style, offsets) for part, offsets in parts
        )
        source_line += 1

    return result or [VisualLine("", 0)]


def visual_index_for_source(visual_lines: list[VisualLine], source_line: int) -> int:
    """Find the first visual row belonging to a source line."""
    for index, visual_line in enumerate(visual_lines):
        if visual_line.source_line >= source_line:
            return index
    return max(0, len(visual_lines) - 1)


def visual_index_for_match(
    visual_lines: list[VisualLine], match: SearchMatch
) -> int:
    """Find the first visual row containing part of a concrete match."""
    for index, visual_line in enumerate(visual_lines):
        if highlight_ranges(visual_line, match):
            return index
    return visual_index_for_source(visual_lines, match.source_line)


def find_text_matches(lines: list[str], query: str) -> list[SearchMatch]:
    """Return non-overlapping, case-insensitive matches in document order."""
    folded_query = query.casefold()
    if not folded_query:
        return []
    matches: list[SearchMatch] = []
    for source_line, line in enumerate(lines):
        folded_parts: list[str] = []
        folded_to_source: list[int] = []
        for source_offset, character in enumerate(line):
            folded_character = character.casefold()
            folded_parts.append(folded_character)
            folded_to_source.extend([source_offset] * len(folded_character))
        folded_line = "".join(folded_parts)
        offset = 0
        while (found := folded_line.find(folded_query, offset)) >= 0:
            source_start = folded_to_source[found]
            source_end = folded_to_source[found + len(folded_query) - 1] + 1
            matches.append(SearchMatch(source_line, source_start, source_end))
            offset = found + len(folded_query)
    return matches


def highlight_ranges(
    visual_line: VisualLine, match: SearchMatch
) -> list[tuple[int, int]]:
    """Return display-character ranges intersecting a source-level match."""
    if visual_line.source_line != match.source_line:
        return []
    ranges: list[tuple[int, int]] = []
    range_start: int | None = None
    for index, source_offset in enumerate(visual_line.source_offsets):
        highlighted = (
            source_offset is not None
            and match.source_start <= source_offset < match.source_end
        )
        if highlighted and range_start is None:
            range_start = index
        elif not highlighted and range_start is not None:
            ranges.append((range_start, index))
            range_start = None
    if range_start is not None:
        ranges.append((range_start, len(visual_line.source_offsets)))
    return ranges


def display_width(text: str) -> int:
    """Approximate terminal cell width using Unicode standard properties."""
    width = 0
    for character in text:
        if unicodedata.combining(character) or unicodedata.category(character) in {
            "Cc",
            "Cf",
            "Me",
            "Mn",
        }:
            continue
        width += 2 if unicodedata.east_asian_width(character) in {"W", "F"} else 1
    return width


def clip_to_display_width(text: str, maximum_width: int) -> str:
    """Clip text without splitting a character beyond the terminal cell limit."""
    result: list[str] = []
    width = 0
    for character in text:
        character_width = display_width(character)
        if width + character_width > maximum_width:
            break
        result.append(character)
        width += character_width
    return "".join(result)


def stepped_match_index(
    current_index: int, match_count: int, direction: int
) -> int | None:
    """Return the next cyclic match index, or None when there are no matches."""
    if match_count == 0:
        return None
    return (current_index + direction) % match_count


def is_quit_key(key: int | str) -> bool:
    """Return whether a key is one of the application's explicit quit keys."""
    return key in ("q", "Q")


def read_markdown(path: Path) -> list[str]:
    """Read a regular UTF-8 file and return source lines without line endings."""
    if not path.exists():
        raise ValueError(f"file does not exist: {path}")
    if not path.is_file():
        raise ValueError(f"path is not a regular file: {path}")
    try:
        return path.read_text(encoding="utf-8").splitlines()
    except PermissionError as error:
        raise ValueError(f"permission denied: {path}") from error
    except UnicodeDecodeError as error:
        raise ValueError(f"file is not valid UTF-8: {path}") from error
    except OSError as error:
        raise ValueError(f"could not read file {path}: {error}") from error


class Viewer:
    """Own the viewer state, input handling, resizing, and curses drawing."""

    def __init__(
        self,
        screen: curses.window,
        path: Path,
        source_lines: list[str],
        return_on_escape: bool = False,
    ):
        self.screen = screen
        self.path = path
        self.source_lines = source_lines
        self.headings = parse_headings(source_lines)
        self.toc_depth = 3
        self.toc_selected = 0
        self.toc_top = 0
        self.document_top = 0
        self.active_panel = "toc"
        self.visual_lines: list[VisualLine] = []
        self.last_document_width = -1
        self.search_input: str | None = None
        self.search_query = ""
        self.search_matches: list[SearchMatch] = []
        self.search_match_index: int | None = None
        self.search_message: str | None = None
        self.return_on_escape = return_on_escape

    def run(self) -> str:
        """Run the Reader until the user requests exit or repository return."""
        curses.curs_set(0)
        self.screen.keypad(True)
        while True:
            self._rebuild_after_resize()
            self._draw()
            key = self.screen.get_wch()
            if self.search_input is not None:
                self._handle_search_input(key)
                continue
            if key == "h" and self.return_on_escape and self.active_panel == "toc":
                key = "\x1b"
            if is_quit_key(key):
                return "quit"
            if self._repository_return_requested(key):
                return "back"
            self._handle_key(key)

    def _repository_return_requested(self, key: int | str) -> bool:
        """Return whether the existing remote-Reader Esc action is available."""
        return (
            self.return_on_escape
            and not self.search_query
            and self.search_message is None
            and key == "\x1b"
        )

    def _layout(self) -> tuple[int, int, int]:
        height, width = self.screen.getmaxyx()
        toc_width = max(MIN_PANEL_WIDTH, int(width * TOC_RATIO))
        toc_width = min(toc_width, max(MIN_PANEL_WIDTH, width - MIN_PANEL_WIDTH))
        return height, width, toc_width

    def _rebuild_after_resize(self) -> None:
        height, width, toc_width = self._layout()
        document_width = max(1, width - toc_width - 3)
        if document_width == self.last_document_width:
            return
        anchor_source = 0
        match_was_visible = False
        current_match = self._current_search_match()
        if self.visual_lines:
            anchor_source = self.visual_lines[self.document_top].source_line
            if current_match is not None:
                match_visual_index = visual_index_for_match(
                    self.visual_lines, current_match
                )
                visible_height = max(1, height - 3)
                match_was_visible = (
                    self.document_top
                    <= match_visual_index
                    < self.document_top + visible_height
                )
        self.visual_lines = build_visual_lines(self.source_lines, document_width)
        if current_match is not None and match_was_visible:
            self.document_top = visual_index_for_match(
                self.visual_lines, current_match
            )
        else:
            self.document_top = visual_index_for_source(
                self.visual_lines, anchor_source
            )
        self.last_document_width = document_width
        self._clamp_document(height)
        if self.active_panel == "document":
            self._sync_toc_to_document()

    def _visible_headings(self) -> list[Heading]:
        return [heading for heading in self.headings if heading.level <= self.toc_depth]

    def _handle_key(self, key: int | str) -> None:
        height, _, _ = self._layout()
        page = max(1, height - 4)
        self.search_message = None
        if key == "\x1b":
            self._reset_search()
        elif key == "/":
            self.search_input = ""
        elif key == ".":
            self._repeat_search(1)
        elif key == ",":
            self._repeat_search(-1)
        elif key == "h":
            self.active_panel = "toc"
        elif key == "l":
            if self.active_panel == "toc":
                self._jump_to_selected_heading()
            self.active_panel = "document"
        elif key == "\t":
            if self.active_panel == "toc":
                self._jump_to_selected_heading()
                self.active_panel = "document"
            else:
                self.active_panel = "toc"
        elif key in ("1", "2", "3"):
            self._change_toc_depth(int(key))
        else:
            navigation_key = {
                "j": curses.KEY_DOWN,
                "k": curses.KEY_UP,
            }.get(key, key)
            if self.active_panel == "toc":
                self._handle_toc_key(navigation_key, page)
            else:
                self._handle_document_key(navigation_key, page, height)

    def _handle_search_input(self, key: int | str) -> None:
        """Edit, cancel, or submit the active Unicode search prompt."""
        if key == "\x1b":
            self.search_input = None
            self.search_message = None
        elif key in ("\n", "\r", curses.KEY_ENTER):
            query = self.search_input
            self.search_input = None
            if query:
                self._perform_search(query)
        elif key in ("\b", "\x7f", curses.KEY_BACKSPACE, 8, 127):
            self.search_input = self.search_input[:-1]
        elif isinstance(key, str) and key.isprintable():
            self.search_input += key

    def _perform_search(self, query: str) -> None:
        """Store a query and jump to its first source-level match."""
        matches = find_text_matches(self.source_lines, query)
        self.search_query = query
        self.search_matches = matches
        if not matches:
            self.search_match_index = None
            self.search_message = f"Not found: {query}"
            return
        self.search_match_index = 0
        self.search_message = None
        self._show_current_search_match()

    def _reset_search(self) -> None:
        """Clear completed search state without moving the document viewport."""
        self.search_query = ""
        self.search_matches = []
        self.search_match_index = None
        self.search_message = None

    def _repeat_search(self, direction: int) -> None:
        """Move cyclically through matches of the last successful query."""
        if self.search_match_index is None or not self.search_matches:
            return
        next_index = stepped_match_index(
            self.search_match_index, len(self.search_matches), direction
        )
        if next_index is not None:
            self.search_match_index = next_index
            self._show_current_search_match()

    def _show_current_search_match(self) -> None:
        """Make the current match visible and synchronize the table of contents."""
        if self.search_match_index is None:
            return
        match = self.search_matches[self.search_match_index]
        self.document_top = visual_index_for_match(self.visual_lines, match)
        height, _, _ = self._layout()
        self._clamp_document(height)
        self._sync_toc_to_document()

    def _change_toc_depth(self, depth: int) -> None:
        current_source = None
        visible = self._visible_headings()
        if visible:
            current_source = visible[self.toc_selected].source_line
        self.toc_depth = depth
        updated = self._visible_headings()
        if not updated:
            self.toc_selected = self.toc_top = 0
            return
        if current_source is not None:
            candidates = [
                index
                for index, heading in enumerate(updated)
                if heading.source_line <= current_source
            ]
            self.toc_selected = candidates[-1] if candidates else 0
        self._position_toc_selection_after_depth_change()

    def _handle_toc_key(self, key: int | str, page: int) -> None:
        headings = self._visible_headings()
        if not headings:
            return
        last = len(headings) - 1
        if key == curses.KEY_UP:
            self.toc_selected = max(0, self.toc_selected - 1)
        elif key == curses.KEY_DOWN:
            self.toc_selected = min(last, self.toc_selected + 1)
        elif key == curses.KEY_PPAGE:
            self.toc_selected = max(0, self.toc_selected - page)
        elif key == curses.KEY_NPAGE:
            self.toc_selected = min(last, self.toc_selected + page)
        elif key == curses.KEY_HOME:
            self.toc_selected = 0
        elif key == curses.KEY_END:
            self.toc_selected = last
        elif key in (curses.KEY_ENTER, "\n", "\r"):
            self._jump_to_selected_heading()
        self._ensure_toc_visible()

    def _jump_to_selected_heading(self) -> None:
        """Position the document at the currently selected visible heading."""
        headings = self._visible_headings()
        if headings:
            self.document_top = visual_index_for_source(
                self.visual_lines, headings[self.toc_selected].source_line
            )

    def _handle_document_key(self, key: int | str, page: int, height: int) -> None:
        navigation_keys = {
            curses.KEY_UP,
            curses.KEY_DOWN,
            curses.KEY_PPAGE,
            curses.KEY_NPAGE,
            curses.KEY_HOME,
            curses.KEY_END,
        }
        if key not in navigation_keys:
            return
        if key == curses.KEY_UP:
            self.document_top -= 1
        elif key == curses.KEY_DOWN:
            self.document_top += 1
        elif key == curses.KEY_PPAGE:
            self.document_top -= page
        elif key == curses.KEY_NPAGE:
            self.document_top += page
        elif key == curses.KEY_HOME:
            self.document_top = 0
        elif key == curses.KEY_END:
            self.document_top = len(self.visual_lines)
        self._clamp_document(height)
        self._sync_toc_to_document()

    def _clamp_document(self, height: int) -> None:
        visible_height = max(1, height - 3)
        maximum = max(0, len(self.visual_lines) - visible_height)
        self.document_top = min(max(0, self.document_top), maximum)

    def _ensure_toc_visible(self) -> None:
        height, _, _ = self._layout()
        visible_height = max(1, height - 3)
        if self.toc_selected < self.toc_top:
            self.toc_top = self.toc_selected
        elif self.toc_selected >= self.toc_top + visible_height:
            self.toc_top = self.toc_selected - visible_height + 1

    def _position_toc_selection_after_depth_change(self) -> None:
        """Place the retained selection near the viewport's upper third."""
        height, _, _ = self._layout()
        visible_height = max(1, height - 3)
        maximum_top = max(0, len(self._visible_headings()) - visible_height)
        preferred_row = visible_height // 3
        self.toc_top = min(
            max(0, self.toc_selected - preferred_row), maximum_top
        )

    def _sync_toc_to_document(self) -> None:
        """Select the visible-depth heading preceding the document viewport."""
        headings = self._visible_headings()
        if not headings or not self.visual_lines:
            return
        source_line = self.visual_lines[self.document_top].source_line
        candidates = [
            index
            for index, heading in enumerate(headings)
            if heading.source_line <= source_line
        ]
        self.toc_selected = candidates[-1] if candidates else 0
        self._ensure_toc_visible()

    def _draw(self) -> None:
        self.screen.erase()
        height, width, toc_width = self._layout()
        if height < MIN_TERMINAL_HEIGHT or width < MIN_TERMINAL_WIDTH:
            self._set_cursor(False)
            self._safe_add(0, 0, "Resize terminal to at least 40×8", curses.A_BOLD)
            self.screen.refresh()
            return

        content_bottom = height - 1
        self._draw_box(0, 0, content_bottom, toc_width, self.active_panel == "toc")
        self._draw_box(
            0, toc_width, content_bottom, width, self.active_panel == "document"
        )
        self._safe_add(
            0,
            2,
            f" Contents (1–{self.toc_depth}) ",
            curses.A_BOLD,
            toc_width - 3,
        )
        title = f" Document: {self.path.name} "
        self._safe_add(
            0,
            toc_width + 2,
            title,
            curses.A_BOLD,
            width - toc_width - 3,
        )
        self._draw_toc(content_bottom, toc_width)
        self._draw_document(content_bottom, toc_width, width)
        if self.search_input is not None:
            status = f" Search: {self.search_input}"
        elif self.search_message is not None:
            status = f" {self.search_message}"
        else:
            status = " h Contents  l Document  j/k move  Tab toggle  1/2/3 TOC  / search  Q quit "
            if self.return_on_escape:
                status = " Esc/h repository " + status.lstrip()
        self._safe_add(height - 1, 0, status.ljust(width), curses.A_REVERSE)
        if self.search_input is not None:
            cursor_column = min(width - 1, display_width(status))
            self._set_cursor(True, height - 1, cursor_column)
        else:
            self._set_cursor(False)
        self.screen.refresh()

    def _draw_box(
        self, top: int, left: int, bottom: int, right: int, active: bool
    ) -> None:
        attribute = curses.A_BOLD if active else curses.A_NORMAL
        horizontal = "═" if active else "─"
        vertical = "║" if active else "│"
        self._safe_add(top, left, "╔" if active else "┌", attribute)
        self._safe_add(top, left + 1, horizontal * max(0, right - left - 2), attribute)
        self._safe_add(top, right - 1, "╗" if active else "┐", attribute)
        for row in range(top + 1, bottom):
            self._safe_add(row, left, vertical, attribute)
            self._safe_add(row, right - 1, vertical, attribute)
        self._safe_add(bottom - 1, left, "╚" if active else "└", attribute)
        self._safe_add(
            bottom - 1,
            left + 1,
            horizontal * max(0, right - left - 2),
            attribute,
        )
        self._safe_add(bottom - 1, right - 1, "╝" if active else "┘", attribute)

    def _draw_toc(self, bottom: int, width: int) -> None:
        headings = self._visible_headings()
        visible_height = max(0, bottom - 2)
        visible = headings[self.toc_top : self.toc_top + visible_height]
        for row, heading in enumerate(visible, 1):
            index = self.toc_top + row - 1
            prefix = "  " * (heading.level - 1)
            marker = "> " if index == self.toc_selected else "  "
            attribute = (
                curses.A_REVERSE if index == self.toc_selected else curses.A_NORMAL
            )
            self._safe_add(row, 1, marker + prefix + heading.title, attribute, width - 2)

    def _draw_document(self, bottom: int, left: int, width: int) -> None:
        visible_height = max(0, bottom - 2)
        available_width = width - left - 2
        for row, visual_line in enumerate(
            self.visual_lines[self.document_top : self.document_top + visible_height], 1
        ):
            attribute = document_attribute(visual_line.style)
            self._safe_add(row, left + 1, visual_line.text, attribute, available_width)
            match = self._current_search_match()
            if match is not None:
                for start, end in highlight_ranges(visual_line, match):
                    prefix_width = display_width(visual_line.text[:start])
                    self._safe_add(
                        row,
                        left + 1 + prefix_width,
                        visual_line.text[start:end],
                        SEARCH_HIGHLIGHT_ATTRIBUTE,
                        available_width - prefix_width,
                    )

    def _current_search_match(self) -> SearchMatch | None:
        """Return the selected concrete match, if search has a result."""
        if self.search_match_index is None:
            return None
        return self.search_matches[self.search_match_index]

    def _set_cursor(
        self, visible: bool, row: int | None = None, column: int | None = None
    ) -> None:
        """Set the real terminal cursor state without failing on limited terminals."""
        try:
            curses.curs_set(1 if visible else 0)
            if visible and row is not None and column is not None:
                self.screen.move(row, column)
        except curses.error:
            LOG.debug("Terminal does not support changing cursor visibility")

    def _safe_add(
        self, row: int, column: int, text: str, attribute: int = 0, limit: int | None = None
    ) -> None:
        """Draw clipped text; curses may reject the terminal's lower-right cell."""
        height, width = self.screen.getmaxyx()
        if row < 0 or row >= height or column < 0 or column >= width:
            return
        maximum = max(0, width - column)
        if limit is not None:
            maximum = min(maximum, max(0, limit))
        clipped = clip_to_display_width(text, maximum)
        try:
            self.screen.addstr(row, column, clipped, attribute)
        except curses.error:
            LOG.debug("Could not draw text at %s:%s", row, column)


class RepositoryView:
    """Browse one read-only repository and open documents in the Reader."""

    def __init__(
        self,
        screen: curses.window,
        repository_url: str,
        repository: Repository,
    ):
        self.screen = screen
        self.repository_url = repository_url
        self.repository = repository
        self.directory_rows = repository_directories(repository)
        self.directory_selected = 0
        self.directory_top = 0
        self.document_selected = 0
        self.document_top = 0
        self.active_panel = "directories"
        self.message: str | None = None

    def run(self) -> None:
        """Run Repository View until Q or a nested Reader requests exit."""
        curses.curs_set(0)
        self.screen.keypad(True)
        while True:
            self._clamp_selection()
            self._draw()
            key = self.screen.get_wch()
            if is_quit_key(key):
                return
            if key == "l" and self.active_panel == "documents":
                key = curses.KEY_ENTER
            self.message = None
            if key == "r":
                self._refresh_repository()
            elif key == "\t":
                self.active_panel = (
                    "documents"
                    if self.active_panel == "directories"
                    else "directories"
                )
            elif key == "h":
                self.active_panel = "directories"
            elif key == "l":
                self.active_panel = "documents"
            else:
                navigation_key = {
                    "j": curses.KEY_DOWN,
                    "k": curses.KEY_UP,
                }.get(key, key)
                if self.active_panel == "directories":
                    self._handle_directory_key(navigation_key)
                else:
                    outcome = self._handle_document_key(navigation_key)
                    if outcome == "quit":
                        return

    def _layout(self) -> tuple[int, int, int]:
        height, width = self.screen.getmaxyx()
        left_width = max(MIN_PANEL_WIDTH, int(width * TOC_RATIO))
        left_width = min(
            left_width, max(MIN_PANEL_WIDTH, width - MIN_PANEL_WIDTH)
        )
        return height, width, left_width

    def _selected_directory(self) -> RepositoryDirectory | None:
        if not self.directory_rows:
            return None
        return self.directory_rows[self.directory_selected][0]

    def _documents(self) -> tuple[RepositoryDocument, ...]:
        directory = self._selected_directory()
        return directory.documents if directory is not None else ()

    def _refresh_repository(self) -> None:
        """Reload the index atomically and retain selections by stable paths."""
        selected_directory = self._selected_directory()
        selected_directory_path = (
            selected_directory.path if selected_directory is not None else None
        )
        documents = self._documents()
        selected_document_path = (
            documents[self.document_selected].path if documents else None
        )
        old_directory_index = self.directory_selected
        old_document_index = self.document_selected

        try:
            updated_repository = load_repository(self.repository_url)
        except RepositoryError as error:
            self.message = f"Refresh failed: {error}"
            return

        updated_rows = repository_directories(updated_repository)
        matching_directory = next(
            (
                index
                for index, (directory, _depth) in enumerate(updated_rows)
                if directory.path == selected_directory_path
            ),
            None,
        )
        self.repository = updated_repository
        self.directory_rows = updated_rows
        if matching_directory is None:
            self.directory_selected = min(
                old_directory_index, max(0, len(updated_rows) - 1)
            )
        else:
            self.directory_selected = matching_directory

        updated_documents = self._documents()
        matching_document = next(
            (
                index
                for index, document in enumerate(updated_documents)
                if document.path == selected_document_path
            ),
            None,
        )
        if matching_document is None:
            self.document_selected = min(
                old_document_index, max(0, len(updated_documents) - 1)
            )
        else:
            self.document_selected = matching_document
        self._clamp_selection()
        self.message = "Repository refreshed"

    def _clamp_selection(self) -> None:
        height, _, _ = self._layout()
        visible_height = max(1, height - 3)
        self.directory_selected = min(
            self.directory_selected, max(0, len(self.directory_rows) - 1)
        )
        documents = self._documents()
        self.document_selected = min(
            self.document_selected, max(0, len(documents) - 1)
        )
        self.directory_top = self._visible_top(
            self.directory_top,
            self.directory_selected,
            len(self.directory_rows),
            visible_height,
        )
        self.document_top = self._visible_top(
            self.document_top,
            self.document_selected,
            len(documents),
            visible_height,
        )

    @staticmethod
    def _visible_top(
        top: int, selected: int, count: int, visible_height: int
    ) -> int:
        """Keep one selected list row visible without changing its selection."""
        maximum_top = max(0, count - visible_height)
        top = min(max(0, top), maximum_top)
        if selected < top:
            return selected
        if selected >= top + visible_height:
            return selected - visible_height + 1
        return top

    def _handle_directory_key(self, key: int | str) -> None:
        previous = self.directory_selected
        last = max(0, len(self.directory_rows) - 1)
        if key == curses.KEY_UP:
            self.directory_selected = max(0, previous - 1)
        elif key == curses.KEY_DOWN:
            self.directory_selected = min(last, previous + 1)
        elif key == curses.KEY_HOME:
            self.directory_selected = 0
        elif key == curses.KEY_END:
            self.directory_selected = last
        if self.directory_selected != previous:
            self.document_selected = 0
            self.document_top = 0

    def _handle_document_key(self, key: int | str) -> str | None:
        documents = self._documents()
        last = max(0, len(documents) - 1)
        if key == curses.KEY_UP:
            self.document_selected = max(0, self.document_selected - 1)
        elif key == curses.KEY_DOWN:
            self.document_selected = min(last, self.document_selected + 1)
        elif key == curses.KEY_HOME:
            self.document_selected = 0
        elif key == curses.KEY_END:
            self.document_selected = last
        elif key in (curses.KEY_ENTER, "\n", "\r") and documents:
            return self._open_document(documents[self.document_selected])
        return None

    def _open_document(self, document: RepositoryDocument) -> str | None:
        """Download one selected document and run the existing Reader for it."""
        try:
            url = document_url(self.repository_url, document.path)
            source_lines = fetch_utf8(url).splitlines()
        except RepositoryError as error:
            self.message = str(error)
            return None
        reader = Viewer(
            self.screen,
            Path(document.name),
            source_lines,
            return_on_escape=True,
        )
        return reader.run()

    def _draw(self) -> None:
        self.screen.erase()
        height, width, left_width = self._layout()
        if height < MIN_TERMINAL_HEIGHT or width < MIN_TERMINAL_WIDTH:
            self._safe_add(0, 0, "Resize terminal to at least 40×8", curses.A_BOLD)
            self.screen.refresh()
            return
        content_bottom = height - 1
        self._draw_box(
            0,
            0,
            content_bottom,
            left_width,
            self.active_panel == "directories",
        )
        self._draw_box(
            0,
            left_width,
            content_bottom,
            width,
            self.active_panel == "documents",
        )
        self._safe_add(
            0, 2, " Directories ", curses.A_BOLD, left_width - 3
        )
        self._safe_add(
            0,
            left_width + 2,
            f" Repository: {self.repository.name} ",
            curses.A_BOLD,
            width - left_width - 3,
        )
        visible_height = max(0, content_bottom - 2)
        for row, (directory, depth) in enumerate(
            self.directory_rows[
                self.directory_top : self.directory_top + visible_height
            ],
            1,
        ):
            index = self.directory_top + row - 1
            marker = "> " if index == self.directory_selected else "  "
            attribute = (
                curses.A_REVERSE
                if index == self.directory_selected
                else curses.A_NORMAL
            )
            self._safe_add(
                row,
                1,
                marker + "  " * depth + directory.name,
                attribute,
                left_width - 2,
            )
        documents = self._documents()
        for row, document in enumerate(
            documents[self.document_top : self.document_top + visible_height], 1
        ):
            index = self.document_top + row - 1
            marker = "> " if index == self.document_selected else "  "
            attribute = (
                curses.A_REVERSE
                if index == self.document_selected
                else curses.A_NORMAL
            )
            self._safe_add(
                row,
                left_width + 1,
                marker + document.name,
                attribute,
                width - left_width - 2,
            )
        status = self.message or (
            "h Directories  l Documents/open  j/k move  r Refresh  Enter open  Q quit"
        )
        self._safe_add(
            height - 1,
            0,
            f" {status} ".ljust(width),
            curses.A_REVERSE,
            width,
        )
        self.screen.refresh()

    def _draw_box(
        self, top: int, left: int, bottom: int, right: int, active: bool
    ) -> None:
        attribute = curses.A_BOLD if active else curses.A_NORMAL
        horizontal = "═" if active else "─"
        vertical = "║" if active else "│"
        self._safe_add(top, left, "╔" if active else "┌", attribute)
        self._safe_add(
            top, left + 1, horizontal * max(0, right - left - 2), attribute
        )
        self._safe_add(top, right - 1, "╗" if active else "┐", attribute)
        for row in range(top + 1, bottom):
            self._safe_add(row, left, vertical, attribute)
            self._safe_add(row, right - 1, vertical, attribute)
        self._safe_add(bottom - 1, left, "╚" if active else "└", attribute)
        self._safe_add(
            bottom - 1,
            left + 1,
            horizontal * max(0, right - left - 2),
            attribute,
        )
        self._safe_add(bottom - 1, right - 1, "╝" if active else "┘", attribute)

    def _safe_add(
        self,
        row: int,
        column: int,
        text: str,
        attribute: int = 0,
        limit: int | None = None,
    ) -> None:
        """Draw clipped Repository View text without lower-right failures."""
        height, width = self.screen.getmaxyx()
        if row < 0 or row >= height or column < 0 or column >= width:
            return
        maximum = max(0, width - column)
        if limit is not None:
            maximum = min(maximum, max(0, limit))
        try:
            self.screen.addstr(
                row, column, clip_to_display_width(text, maximum), attribute
            )
        except curses.error:
            LOG.debug("Could not draw repository text at %s:%s", row, column)


def parse_args(arguments: list[str] | None = None) -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="View a local Markdown file or browse the test repository"
    )
    parser.add_argument(
        "file",
        type=Path,
        nargs="?",
        help="local Markdown file encoded as UTF-8",
    )
    parser.add_argument("--version", action="version", version=f"mdview {VERSION}")
    return parser.parse_args(arguments)


def main(arguments: list[str] | None = None) -> int:
    """Validate input, enter curses safely, and return a process exit status."""
    args = parse_args(arguments)
    source_lines: list[str] | None = None
    repository: Repository | None = None
    if args.file is not None:
        try:
            source_lines = read_markdown(args.file)
        except ValueError as error:
            print(f"mdview: error: {error}", file=sys.stderr)
            return 1
    else:
        try:
            repository = load_repository(REPOSITORY_URL)
        except RepositoryError as error:
            print(f"mdview: repository error: {error}", file=sys.stderr)
            return 1

    locale.setlocale(locale.LC_ALL, "")
    try:
        if args.file is not None and source_lines is not None:
            curses.wrapper(lambda screen: Viewer(screen, args.file, source_lines).run())
        elif repository is not None:
            curses.wrapper(
                lambda screen: RepositoryView(
                    screen, REPOSITORY_URL, repository
                ).run()
            )
    except KeyboardInterrupt:
        return 130
    except curses.error as error:
        print(f"mdview: terminal error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
