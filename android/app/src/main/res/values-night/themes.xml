<!--
  themes.xml — created 2026-08-26, version 0.1.0.
  Purpose: select a dark platform window while Compose follows system night mode.
  Algorithm: mirror the light no-action-bar theme with its dark counterpart.
-->
<resources>
    <style name="Theme.Mdview" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
